# Server Environment Variables — Udupipages Beach Run 2026

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Transaction pooler on port 6543 (required for Render/IPv6)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# ─── Razorpay (TEST MODE) ─────────────────────────────────────────────────────
# Find at: https://dashboard.razorpay.com → Settings → API Keys → Test Keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayTestSecretHere
# Find at: Settings → Webhooks → your webhook → Webhook Secret
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# ─── SMTP (Email / Nodemailer) ────────────────────────────────────────────────
# Gmail example: use App Password (not account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Udupipages Beach Run 2026 <your-email@gmail.com>

# ─── JWT (Admin Auth) ─────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=generate_a_strong_random_secret_here

# ─── Admin Seed Credentials ───────────────────────────────────────────────────
ADMIN_EMAIL=admin@udupipagesrun.com
ADMIN_PASSWORD=ChangeThisStrongPassword123!
