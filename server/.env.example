# Server Environment Variables
PORT=5000
CLIENT_URL=http://localhost:5173

# Razorpay API Credentials (Test Mode by Default)
# Swap with rzp_live_xxxxxxxx and live secret before production launch
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpayTestSecretHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# Supabase PostgreSQL Configuration
# Note: For Render deployment or IPv6 networks, always use the transaction pooler on port 6543
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
